#!/usr/bin/env sh
# Runs Yoke from this checkout without installing it or setting PYTHONPATH.
# Uses ./venv if it exists, otherwise python3. Options are passed through, e.g. ./run-yoke --id 2
here=$(cd "$(dirname "$0")" && pwd)
python="$here/venv/bin/python"
[ -x "$python" ] || python=python3
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec "$python" "$here/bin/yoke" "$@"
